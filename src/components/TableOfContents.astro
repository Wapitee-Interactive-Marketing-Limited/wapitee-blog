---
import { t, type Lang } from '../i18n/translations';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: Lang;
}

const { headings, lang = 'en' } = Astro.props;

// Top-level sections only (h2) — keeps the TOC compact; very long
// articles stay navigable because the card scrolls internally
const sections = headings.filter(h => h.depth === 2);
---

{sections.length > 0 && (
  <nav class="toc" aria-label={t(lang, 'article.tocTitle')}>
    <h3 class="toc__title">{t(lang, 'article.tocTitle')}</h3>
    <ul class="toc__list">
      {sections.map(h2 => (
        <li class="toc__item">
          <a class="toc__link" href={`#${h2.slug}`}>{h2.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
.toc {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
}

/* Desktop only: the sticky sidebar must never exceed the viewport —
   long TOCs scroll inside the card instead of getting clipped */
@media (min-width: 1025px) {
  .toc {
    max-height: calc(100vh - var(--nav-height) - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .toc::-webkit-scrollbar {
    width: 5px;
  }
  .toc::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 3px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
}

.toc__title {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-mute);
  margin-bottom: 0.85rem;
}

.toc__list {
  list-style: none;
  padding: 0;
}

.toc__item {
  margin-bottom: 0.15rem;
}

.toc__link {
  display: block;
  padding: 0.3rem 0.6rem;
  font-size: 0.85rem;
  line-height: 1.4;
  color: var(--ink-soft);
  text-decoration: none;
  border-left: 2px solid transparent;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.toc__link:hover {
  color: var(--brand);
}

.toc__link.active {
  color: var(--brand);
  font-weight: 600;
  border-left-color: var(--brand);
  background: var(--bg-tint);
}
</style>
